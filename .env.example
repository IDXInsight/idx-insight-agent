# Copy to .env and fill in locally. Never commit real values.

# Sectors data mode. Only "mock" is implemented (real integration is Phase 4).
SECTORS_DATA_MODE=mock
# Required only once the real Sectors adapter exists (Phase 4).
SECTORS_API_KEY=

# LLM runtime: "offline" (deterministic, no network) or "anthropic".
LLM_PROVIDER=offline
LLM_MODEL=claude-opus-5
# Read by the Anthropic SDK when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Agent guardrails
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_SECOND_HOP=3
AGENT_MAX_REQUERIES=2
