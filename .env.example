# Copy to .env and fill in locally. Never commit real values.

# --- Sectors data -----------------------------------------------------------
# "mock": fictional fixtures (tests, UI work, no credits)
# "real": the Sectors v2 REST API (needs SECTORS_API_KEY; spends credits)
SECTORS_DATA_MODE=mock
SECTORS_API_KEY=
# Local cache of real responses (git-ignored, backend/.sectors_local/):
#   readwrite = reuse fresh cached answers, call the API otherwise (default)
#   replay    = cached answers only, never call the API (0 credits)
#   off       = always call the API (still capped and recorded)
SECTORS_CACHE_MODE=readwrite
# Hard caps checked before every request (worst-case cost per the Sectors billing rules)
SECTORS_MAX_CREDITS_PER_DAY=60
SECTORS_MAX_CREDITS_TOTAL=700

# --- Runtime LLM ------------------------------------------------------------
# "none"   : no LLM; every agent decision uses the deterministic policies (default)
# "gemini" : Google Gemini API  (needs GEMINI_API_KEY)
# "groq"   : Groq API           (needs GROQ_API_KEY)
# The final provider is not decided yet. Free-tier availability depends on each
# provider's current quotas and policies.
LLM_PROVIDER=none
# Required when LLM_PROVIDER is gemini or groq. Candidates being evaluated, e.g.:
#   gemini -> gemini-3.8-flash
#   groq   -> openai/gpt-oss-120b
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=20
# Leave empty to use the provider's default temperature.
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=4096

# --- Agent guardrails -------------------------------------------------------
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_SECOND_HOP=3
AGENT_MAX_REQUERIES=2
