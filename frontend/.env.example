# Server-side only (never prefixed with NEXT_PUBLIC_). Copy to .env.local for development.
# FastAPI backend base URL. Leave empty to run the UI in example mode (no API calls).
IDX_INSIGHT_API_URL=http://127.0.0.1:8000
# Optional: timeout for one agent run, in milliseconds.
AGENT_TIMEOUT_MS=110000
# Optional: absolute site URL for social preview images (e.g. the Vercel domain).
NEXT_PUBLIC_SITE_URL=
